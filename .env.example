# Copy this file to .env and fill in YOUR values. .env is git-ignored; this file is not,
# so it must only ever contain variable NAMES and harmless defaults, never real tokens.
#
# Load it in a terminal before running the bot:
#     set -a; source .env; set +a
#     python -m bot.main

# Telegram bot token, from @BotFather. Anyone with it controls the bot.
TELEGRAM_TOKEN=

# Where the trained model is: a local folder (default "model") or a Hugging Face repo id.
MODEL_PATH=model

# Only needed if MODEL_PATH is a PRIVATE Hugging Face repo. Use a read-only token.
HF_TOKEN=
